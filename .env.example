# ==============================================================================
# Sentinel Configuration
# ==============================================================================

# LLM Provider: Google Gemini
# Provide your Generative Language Client API Key:
GEMINI_API_KEY=[GCP_API_KEY]

# Preferred Gemini Model:
GEMINI_MODEL=gemini-flash-latest

# Sentinel API Server
PORT=3001
HOST=127.0.0.1
RUST_LOG=info

# Execution & Retention
SENTINEL_HOME=~/.sentinel
SENTINEL_TRASH=~/.sentinel-trash
TRASH_RETENTION_DAYS=7
