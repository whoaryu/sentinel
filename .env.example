# ==============================================================================
# Sentinel Configuration
# ==============================================================================

# LLM Provider: Google Gemini
# Provide your Generative Language Client API Key:
GEMINI_API_KEY=your_gemini_api_key_here

# Optional: Preferred Gemini Model (defaults to gemini-1.5-flash)
# Supported: gemini-1.5-flash, gemini-2.0-flash, gemini-3.8-flash, gemini-1.5-pro
GEMINI_MODEL=gemini-1.5-flash

# Sentinel API Server
PORT=3001
HOST=127.0.0.1
RUST_LOG=info

# Execution & Retention
SENTINEL_HOME=~/.sentinel
SENTINEL_TRASH=~/.sentinel-trash
TRASH_RETENTION_DAYS=7
